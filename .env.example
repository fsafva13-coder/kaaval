# Copy this file to .env and fill in what you need. Never commit .env.

# true = free offline mode, no API calls. Set to false when you have a key.
MOCK_LLM=true

# nebius = Nebius Token Factory (required for the final submission)
# nvidia = NVIDIA's free developer API (build.nvidia.com), for early testing
# openrouter = free Nemotron models on openrouter.ai (email sign-up, ~200 requests/day)
PROVIDER=nebius
NEBIUS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Optional: override NVIDIA model IDs if check_llm reports one is not found
# NVIDIA_NANO_MODEL=nvidia/nemotron-nano-3-30b-a3b
# NVIDIA_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Budget guard: all model calls stop at the hard cap.
BUDGET_WARN_USD=30
BUDGET_HARD_CAP_USD=40
DAILY_MESSAGE_LIMIT=30

# Owner dashboard passcode (change it!)
OWNER_PASSCODE=change-me
BUSINESS_NAME=mirae.luxe_

# true = replies stay rule-based so only the fraud shield uses model calls
MOCK_REPLIES=false

# Copy this file to .env and fill in what you need. Never commit .env.

# true = free offline mode, no API calls. Set to false when you have a key.
MOCK_LLM=true

# nebius = Nebius Token Factory (required for the final submission)
# nvidia = NVIDIA's free developer API (build.nvidia.com), for early testing
PROVIDER=nebius
NEBIUS_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=

# Budget guard: all model calls stop at the hard cap.
BUDGET_WARN_USD=30
BUDGET_HARD_CAP_USD=40
DAILY_MESSAGE_LIMIT=30

# Owner dashboard passcode (change it!)
OWNER_PASSCODE=change-me
BUSINESS_NAME=mirae.luxe_
